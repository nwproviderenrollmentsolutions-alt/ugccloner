# ── Core ──────────────────────────────────────────────────────────────────
# Local dev: `docker compose up -d postgres` (see docker-compose.yml), or point at
# any managed Postgres for production.
DATABASE_URL="postgresql://ugc:ugc@localhost:5432/ugc_cloner"
AUTH_SECRET="change-me-to-a-long-random-string"
APP_BASE_URL="http://localhost:3000"

# ── Mock mode ────────────────────────────────────────────────────────────
# When true (or when the matching API key below is absent), the app runs
# entirely on mock providers — no paid external calls, realistic fake data,
# every mocked row clearly labeled isMock=true / provider="MOCK_*".
MOCK_AI=true
MOCK_VIDEO=true
MOCK_SEARCH=true
MOCK_AVATAR=true

# ── AI (reasoning / analysis / script generation) ──────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"

# ── YouTube Data API (viral research) ───────────────────────────────────────
YOUTUBE_API_KEY=

# ── Generic web search provider (viral research) ────────────────────────────
SEARCH_API_KEY=
SEARCH_BASE_URL=

# ── Storage (S3-compatible). Leave blank to use local filesystem storage. ───
STORAGE_ENDPOINT=
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_BASE_URL=

# ── Video generation provider (generic HTTP job API) ─────────────────────────
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_BASE_URL=

# ── Avatar / talking-head provider (generic HTTP job API) ───────────────────
AVATAR_PROVIDER_API_KEY=
AVATAR_PROVIDER_BASE_URL=
